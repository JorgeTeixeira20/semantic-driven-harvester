@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdh: <urn:semantic-driven-harvester:prototype:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sdh:ontology a owl:Ontology ;
    rdfs:label "Ontologia do protótipo Semantic Driven Harvester"@pt ;
    owl:versionInfo "0.1.0" .

sdh:Artigo a owl:Class ;
    rdfs:label "Artigo"@pt .

sdh:Jornal a owl:Class ;
    rdfs:label "Jornal"@pt .

sdh:RecursoWeb a owl:Class ;
    rdfs:label "Recurso Web"@pt .

sdh:CapturaArquivada a owl:Class ;
    rdfs:label "Captura Arquivada"@pt .

sdh:TextoExtraido a owl:Class ;
    rdfs:label "Texto Extraído"@pt .

sdh:EntidadeMencionada a owl:Class ;
    rdfs:label "Entidade Mencionada"@pt .

sdh:Tema a owl:Class ;
    rdfs:label "Tema"@pt .

sdh:publicadoPor a owl:ObjectProperty ;
    rdfs:label "publicado por"@pt ;
    rdfs:domain sdh:Artigo ;
    rdfs:range sdh:Jornal .

sdh:temRecursoWeb a owl:ObjectProperty ;
    rdfs:label "tem recurso Web"@pt ;
    rdfs:domain sdh:Artigo ;
    rdfs:range sdh:RecursoWeb .

sdh:temCaptura a owl:ObjectProperty ;
    rdfs:label "tem captura"@pt ;
    rdfs:domain sdh:RecursoWeb ;
    rdfs:range sdh:CapturaArquivada .

sdh:temTextoExtraido a owl:ObjectProperty ;
    rdfs:label "tem texto extraído"@pt ;
    rdfs:domain sdh:CapturaArquivada ;
    rdfs:range sdh:TextoExtraido .

sdh:mencionaEntidade a owl:ObjectProperty ;
    rdfs:label "menciona entidade"@pt ;
    rdfs:domain sdh:Artigo ;
    rdfs:range sdh:EntidadeMencionada .

sdh:temTema a owl:ObjectProperty ;
    rdfs:label "tem tema"@pt ;
    rdfs:domain sdh:Artigo ;
    rdfs:range sdh:Tema .

sdh:originalURL a owl:DatatypeProperty ;
    rdfs:label "URL original"@pt ;
    rdfs:domain sdh:RecursoWeb ;
    rdfs:range xsd:anyURI .

sdh:tstamp a owl:DatatypeProperty ;
    rdfs:label "timestamp original do Arquivo.pt"@pt ;
    rdfs:domain sdh:CapturaArquivada ;
    rdfs:range xsd:string .

sdh:capturedAt a owl:DatatypeProperty ;
    rdfs:label "capturado em"@pt ;
    rdfs:domain sdh:CapturaArquivada ;
    rdfs:range xsd:dateTime .

sdh:archiveURL a owl:DatatypeProperty ;
    rdfs:label "URL da captura arquivada"@pt ;
    rdfs:domain sdh:CapturaArquivada ;
    rdfs:range xsd:anyURI .

sdh:title a owl:DatatypeProperty ;
    rdfs:label "título"@pt ;
    rdfs:domain sdh:CapturaArquivada ;
    rdfs:range xsd:string .

sdh:mimeType a owl:DatatypeProperty ;
    rdfs:label "tipo MIME"@pt ;
    rdfs:domain sdh:CapturaArquivada ;
    rdfs:range xsd:string .

sdh:contentLength a owl:DatatypeProperty ;
    rdfs:label "tamanho do conteúdo"@pt ;
    rdfs:domain sdh:CapturaArquivada ;
    rdfs:range xsd:nonNegativeInteger .

sdh:digest a owl:DatatypeProperty ;
    rdfs:label "digest"@pt ;
    rdfs:domain sdh:CapturaArquivada ;
    rdfs:range xsd:string .

sdh:encoding a owl:DatatypeProperty ;
    rdfs:label "codificação"@pt ;
    rdfs:domain sdh:CapturaArquivada ;
    rdfs:range xsd:string .

sdh:collection a owl:DatatypeProperty ;
    rdfs:label "coleção"@pt ;
    rdfs:domain sdh:CapturaArquivada ;
    rdfs:range xsd:string .

sdh:snippet a owl:DatatypeProperty ;
    rdfs:label "excerto"@pt ;
    rdfs:domain sdh:CapturaArquivada ;
    rdfs:range xsd:string .

sdh:statusCode a owl:DatatypeProperty ;
    rdfs:label "código de estado HTTP"@pt ;
    rdfs:domain sdh:CapturaArquivada ;
    rdfs:range xsd:integer .

sdh:filePath a owl:DatatypeProperty ;
    rdfs:label "caminho do ficheiro"@pt ;
    rdfs:domain sdh:TextoExtraido ;
    rdfs:range xsd:string .

# --- Caminho D: redundância entre capturas (variante c′, limiar 0,900) ---

sdh:versaoDe a owl:ObjectProperty ;
    rdfs:label "versão de"@pt ;
    rdfs:comment "Liga uma CapturaArquivada redundante à CapturaArquivada que a representa, dentro da Camada 1 (capturas com corpo delimitado e statusCode 200). A captura representante NÃO recebe este triplo — não há nada anterior para apontar. Capturas sem corpo (sem_corpo) e a Camada 2 (sem texto) também não recebem este triplo, por não terem comparação nem representante calculados."@pt ;
    rdfs:domain sdh:CapturaArquivada ;
    rdfs:range sdh:CapturaArquivada .

sdh:similaridade a owl:DatatypeProperty ;
    rdfs:label "similaridade"@pt ;
    rdfs:comment "Jaccard de palavras do corpo do artigo (variante c′, article_body.py) entre esta captura e a sua representante (sdh:versaoDe). Só existe nas capturas redundantes; a representante não tem este triplo, pela mesma razão que não tem sdh:versaoDe."@pt ;
    rdfs:domain sdh:CapturaArquivada ;
    rdfs:range xsd:float .
    # xsd:float, não xsd:decimal: é um rácio de Jaccard calculado em vírgula
    # flutuante (ex.: 0.715241), não um valor decimal exato como dinheiro.

# --- Caminho B: nuance das menções de entidade ---

sdh:Mencao a owl:Class ;
    rdfs:label "Menção"@pt ;
    rdfs:comment "Uma menção concreta de uma EntidadeMencionada num Artigo específico, com as métricas de confiança calculadas sobre as capturas desse artigo (variante c′: só capturas com corpo, Camada 1, contam para estas métricas)."@pt .

sdh:temMencao a owl:ObjectProperty ;
    rdfs:label "tem menção"@pt ;
    rdfs:comment "Liga um Artigo a cada Menção que tem — uma Menção por cada EntidadeMencionada detetada no seu texto."@pt ;
    rdfs:domain sdh:Artigo ;
    rdfs:range sdh:Mencao .

sdh:sobreEntidade a owl:ObjectProperty ;
    rdfs:label "sobre entidade"@pt ;
    rdfs:comment "Liga uma Menção à EntidadeMencionada de que trata."@pt ;
    rdfs:domain sdh:Mencao ;
    rdfs:range sdh:EntidadeMencionada .

sdh:capturasComMencao a owl:DatatypeProperty ;
    rdfs:label "capturas com menção"@pt ;
    rdfs:comment "Nº de capturas do artigo (com corpo, Camada 1) em que esta entidade foi detetada no texto. Corresponde à coluna capturas_com_mencao de corpus_entities.csv."@pt ;
    rdfs:domain sdh:Mencao ;
    rdfs:range xsd:nonNegativeInteger .

sdh:capturasComTexto a owl:DatatypeProperty ;
    rdfs:label "capturas com texto"@pt ;
    rdfs:comment "Nº total de capturas do artigo com corpo (Camada 1) sobre as quais esta deteção foi avaliada; denominador da regra de persistência. Corresponde à coluna capturas_com_texto de corpus_entities.csv (sob a variante c′, o denominador real é 'capturas com corpo', não só 'com texto' — o nome da propriedade mantém-se igual ao da coluna do CSV por continuidade)."@pt ;
    rdfs:domain sdh:Mencao ;
    rdfs:range xsd:nonNegativeInteger .

sdh:ocorrencias a owl:DatatypeProperty ;
    rdfs:label "ocorrências"@pt ;
    rdfs:comment "Nº total de vezes que o termo foi encontrado no corpo, somado por todas as capturas do artigo (contagem de correspondências de texto, não de capturas). Corresponde à coluna ocorrencias de corpus_entities.csv."@pt ;
    rdfs:domain sdh:Mencao ;
    rdfs:range xsd:nonNegativeInteger .

sdh:persistente a owl:DatatypeProperty ;
    rdfs:label "persistente"@pt ;
    rdfs:comment "true se capturasComMencao == capturasComTexto (a entidade aparece em todas as capturas com corpo do artigo — regra de persistência); false caso contrário (regra fraca, só ≥ 1 captura). Corresponde à coluna persistente de corpus_entities.csv."@pt ;
    rdfs:domain sdh:Mencao ;
    rdfs:range xsd:boolean .

sdh:clubeCoerente a owl:DatatypeProperty ;
    rdfs:label "clube coerente"@pt ;
    rdfs:comment "Sinal, não filtro: 'sim' se um clube da entidade no vocabulário coincide com o tema clube do URL do artigo; 'nao' se não coincide (possível falso positivo); 'sem_tema' se o artigo não tem tema de clube no URL. Corresponde à coluna clube_coerente de corpus_entities.csv; valores possíveis são exatamente estes três literais."@pt ;
    rdfs:domain sdh:Mencao ;
    rdfs:range xsd:string .

# --- Literais do nó Tema (para não ficar opaco) ---

sdh:categoriaTema a owl:DatatypeProperty ;
    rdfs:label "categoria do tema"@pt ;
    rdfs:comment "A categoria do Tema: 'secao', 'modalidade', 'competicao' ou 'clube' — os mesmos valores já usados na coluna categoria de corpus_entities.csv para linhas tipo=tema."@pt ;
    rdfs:domain sdh:Tema ;
    rdfs:range xsd:string .

sdh:valorTema a owl:DatatypeProperty ;
    rdfs:label "valor do tema"@pt ;
    rdfs:comment "O valor do Tema dentro da categoria, ex.: 'benfica' para categoria 'clube'. Corresponde à coluna rotulo de corpus_entities.csv para linhas tipo=tema."@pt ;
    rdfs:domain sdh:Tema ;
    rdfs:range xsd:string .

# --- Subclasses de Tema (2026-10-18): formalizam os 4 valores de
# categoriaTema já em uso, em vez de os deixar só numa string literal. Cada
# nó Tema passa a ter, além de `a sdh:Tema`, também `a` a sua subclasse
# específica (corpus_entities_rdf.py); categoriaTema/valorTema mantêm-se,
# por continuidade com corpus_entities.csv. Disjuntas: um Tema nunca é, ao
# mesmo tempo, duas destas categorias.

sdh:Secao a owl:Class ;
    rdfs:label "Secção"@pt ;
    rdfs:subClassOf sdh:Tema ;
    rdfs:comment "Tema cuja categoriaTema é 'secao' — a secção do site onde o artigo está publicado (ex.: 'futebol', 'multimedia')."@pt .

sdh:Modalidade a owl:Class ;
    rdfs:label "Modalidade"@pt ;
    rdfs:subClassOf sdh:Tema ;
    rdfs:comment "Tema cuja categoriaTema é 'modalidade' — o desporto de que o artigo trata (ex.: 'andebol', 'natacao')."@pt .

sdh:Competicao a owl:Class ;
    rdfs:label "Competição"@pt ;
    rdfs:subClassOf sdh:Tema ;
    rdfs:comment "Tema cuja categoriaTema é 'competicao' (ex.: 'liga-nos', 'europeu')."@pt .

sdh:Clube a owl:Class ;
    rdfs:label "Clube"@pt ;
    rdfs:subClassOf sdh:Tema ;
    rdfs:comment "Tema cuja categoriaTema é 'clube' (ex.: 'benfica', 'fc-porto'). Não confundir com uma EntidadeMencionada clube no texto: este é o clube-secção editorial do URL."@pt .

[] a owl:AllDisjointClasses ;
    owl:members ( sdh:Secao sdh:Modalidade sdh:Competicao sdh:Clube ) .

# --- Propriedades funcionais (2026-10-18): já eram verdade na construção
# do grafo, agora declaradas para que um reasoner as possa verificar.

sdh:originalURL a owl:FunctionalProperty .

sdh:temTextoExtraido a owl:FunctionalProperty .
